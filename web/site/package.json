{
  "name": "hearaside-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HEARASIDE website and account API (React + Vite + Tailwind, Express on Vercel)",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "tsx watch server/dev.ts",
    "tokens": "python ../../design/gen_theme.py",
    "screens": "node scripts/copy-screens.mjs",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "mock:plugin-api": "tsx server/dev.ts --memory"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@mdx-js/react": "^3.1.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "@upstash/redis": "^1.39.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "cors": "^2.8.6",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.54.0",
    "motion": "^14.0.0",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router": "^8.4.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/anuphan": "^5.3.0",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
