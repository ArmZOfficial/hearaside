     tresult PLUGIN_API setChannelContextInfos (Vst::IAttributeList* list) override
     {
+        // HEARASIDE patch: some hosts (Studio One) send the channel context before the processor is
+        // connected; keep it and apply it in installAudioProcessor() instead of dropping it.
+        if (getPluginInstance() == nullptr && list != nullptr)
+        {
+            AudioProcessor::TrackProperties early;
+            Vst::String128 earlyName;
+            if (list->getString (Vst::ChannelContext::kChannelNameKey, earlyName, sizeof (earlyName)) == kResultTrue)
+                early.name = std::make_optional (toString (earlyName));
+            Steinberg::int64 earlyColour;
+            if (list->getInt (Vst::ChannelContext::kChannelColorKey, earlyColour) == kResultTrue)
+                early.colourARGB.emplace ((uint32) earlyColour);
+            pendingTrackProperties = early;
+        }
+
