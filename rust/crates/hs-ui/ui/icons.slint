// Stroke icons of the design export (24 x 24 viewBox, stroke 1.8, round caps), from plugins/common/ui/Icons.cpp.
// Circles and rounded rectangles of the C++ path builder are written as SVG arcs.
import { Palette } from "theme.slint";

export enum IconId {
    headphones, broadcast, speaker-off, speaker-on, sliders, warning, more, solo, power, record, drag, folder, link, check, info, close, window, monitor, person, plus, waveform, grip, appearance, audio-bars, connection, spread, play, chevron-left, chevron-right, chevron-down, refresh,
}

component IconPath inherits Path {
    in property <color> ink;
    in property <bool> filled;
    in property <float> weight: 1.8;   // stroke width in the 24-unit box
    viewbox-width: 24;
    viewbox-height: 24;
    fill: filled ? ink : transparent;
    stroke: filled ? transparent : ink;
    stroke-width: weight * min(self.width, self.height) / 24;
    stroke-line-cap: round;
    stroke-line-join: round;
}

// `strike` draws the diagonal over "off" icons (AudibleToggle).
export component Icon inherits Rectangle {
    in property <IconId> id;
    in property <color> ink: Palette.ink;
    in property <length> size: 18px;
    in property <float> weight: 1.8;
    in property <bool> strike;
    in property <angle> rotation;   // 180deg turns a chevron over (open dropdowns)
    width: size;
    height: size;
    Rectangle {
        transform-rotation: root.rotation;
        if root.id == IconId.headphones: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M4 17v-5a8 8 0 0 1 16 0v5 M4.8 14h0.9a1.8 1.8 0 0 1 1.8 1.8v3.4a1.8 1.8 0 0 1 -1.8 1.8h-0.9a1.8 1.8 0 0 1 -1.8 -1.8v-3.4a1.8 1.8 0 0 1 1.8 -1.8z M18.3 14h0.9a1.8 1.8 0 0 1 1.8 1.8v3.4a1.8 1.8 0 0 1 -1.8 1.8h-0.9a1.8 1.8 0 0 1 -1.8 -1.8v-3.4a1.8 1.8 0 0 1 1.8 -1.8z";
        }
        if root.id == IconId.broadcast: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M15.5 8.5a5 5 0 0 1 0 7 M8.5 15.5a5 5 0 0 1 0-7 M18.4 5.6a9 9 0 0 1 0 12.8 M5.6 18.4a9 9 0 0 1 0-12.8 M10 12a2 2 0 1 0 4 0a2 2 0 1 0 -4 0z";
        }
        if root.id == IconId.speaker-off: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M11 5L6 9H3v6h3l5 4V5z M16 9l5 6 M21 9l-5 6";
        }
        if root.id == IconId.speaker-on: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M11 5L6 9H3v6h3l5 4V5z M15.5 8.5a5 5 0 0 1 0 7";
        }
        if root.id == IconId.sliders: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M4 7h10 M18 7h2 M4 17h4 M12 17h8 M14 7a2 2 0 1 0 4 0a2 2 0 1 0 -4 0z M8 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0z";
        }
        if root.id == IconId.warning: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M12 3l9.5 17h-19z M12 10v4 M12 17.5v.5";
        }
        if root.id == IconId.more: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: true;
            commands: "M3.3 12a1.7 1.7 0 1 0 3.4 0a1.7 1.7 0 1 0 -3.4 0z M10.3 12a1.7 1.7 0 1 0 3.4 0a1.7 1.7 0 1 0 -3.4 0z M17.3 12a1.7 1.7 0 1 0 3.4 0a1.7 1.7 0 1 0 -3.4 0z";
        }
        if root.id == IconId.solo: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M12 3v18 M7 8h10 M5 16h14";
        }
        if root.id == IconId.power: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M12 3v8 M6.3 6.8a8 8 0 1 0 11.4 0";
        }
        if root.id == IconId.record: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: true;
            commands: "M6 12a6 6 0 1 0 12 0a6 6 0 1 0 -12 0z";
        }
        if root.id == IconId.drag: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M12 3v12 M7 10l5 5 5-5 M4 17v3h16v-3";
        }
        if root.id == IconId.folder: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z";
        }
        if root.id == IconId.link: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7 M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7";
        }
        if root.id == IconId.check: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M5 12.5l4.5 4.5L19 7.5";
        }
        if root.id == IconId.info: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0z M12 11v6 M12 7.5v.5";
        }
        if root.id == IconId.close: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M6 6l12 12 M18 6L6 18";
        }
        if root.id == IconId.window: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M6 4h12a3 3 0 0 1 3 3v10a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-10a3 3 0 0 1 3 -3z M3 9h18";
        }
        if root.id == IconId.monitor: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M5 4h14a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-8a2 2 0 0 1 2 -2z M8 20h8 M12 16v4";
        }
        if root.id == IconId.person: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M8 8a4 4 0 1 0 8 0a4 4 0 1 0 -8 0z M4 21a8 8 0 0 1 16 0";
        }
        if root.id == IconId.plus: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M12 5v14 M5 12h14";
        }
        if root.id == IconId.waveform: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M3 12h2 M7 8v8 M11 5v14 M15 9v6 M19 11v2";
        }
        if root.id == IconId.grip: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: true;
            commands: "M7.4 6a1.6 1.6 0 1 0 3.2 0a1.6 1.6 0 1 0 -3.2 0z M13.4 6a1.6 1.6 0 1 0 3.2 0a1.6 1.6 0 1 0 -3.2 0z M7.4 12a1.6 1.6 0 1 0 3.2 0a1.6 1.6 0 1 0 -3.2 0z M13.4 12a1.6 1.6 0 1 0 3.2 0a1.6 1.6 0 1 0 -3.2 0z M7.4 18a1.6 1.6 0 1 0 3.2 0a1.6 1.6 0 1 0 -3.2 0z M13.4 18a1.6 1.6 0 1 0 3.2 0a1.6 1.6 0 1 0 -3.2 0z";
        }
        if root.id == IconId.appearance: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0z";
        }
        if root.id == IconId.audio-bars: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M4 10v4 M8 6v12 M12 3v18 M16 7v10 M20 10v4";
        }
        if root.id == IconId.connection: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M9 7H6a5 5 0 0 0 0 10h3 M15 7h3a5 5 0 0 1 0 10h-3 M8 12h8";
        }
        if root.id == IconId.spread: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M4 12h16 M4 12l3-3 M4 12l3 3 M20 12l-3-3 M20 12l-3 3";
        }
        if root.id == IconId.play: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: true;
            commands: "M8 5.5v13l10.5-6.5z";
        }
        if root.id == IconId.chevron-left: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M15 6l-6 6 6 6";
        }
        if root.id == IconId.chevron-right: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M9 6l6 6-6 6";
        }
        if root.id == IconId.chevron-down: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M6 9l6 6 6-6";
        }
        if root.id == IconId.refresh: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight; filled: false;
            commands: "M3 12a9 9 0 0 1 15.5-6.2L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-15.5 6.2L3 16 M3 21v-5h5";
        }
        if root.id == IconId.appearance: IconPath {
            width: root.width; height: root.height; ink: root.ink; filled: true;
            commands: "M12 3A9 9 0 0 0 12 21z";   // the filled left half of the pie segment
        }
        if root.strike: IconPath {
            width: root.width; height: root.height; ink: root.ink; weight: root.weight;
            commands: "M3 3L21 21";
        }
    }
}
