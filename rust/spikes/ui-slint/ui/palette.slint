// Generated from design/tokens.json for the R0.3 spike (light/dark subset).
export global Palette {
    in property <bool> dark;
    out property <color> paper: dark ? #151514 : #f3f3f1;
    out property <color> grid: dark ? #ffffff0b : #1818180d;
    out property <color> ink: dark ? #ededea : #181818;
    out property <color> onInk: dark ? #151514 : #ffffff;
    out property <color> ink2: dark ? #cfcfca : #3e3e3a;
    out property <color> graphite: dark ? #a3a39d : #5a5a56;
    out property <color> offFg: dark ? #ababa4 : #55554f;
    out property <color> muted: dark ? #6e6e69 : #8a8a84;
    out property <color> glass: dark ? #2626249e : #ffffff9e;
    out property <color> glassEdge: dark ? #ffffff1a : #ffffffd9;
    out property <color> inset: dark ? #ffffff0e : #f0f0ede6;
    out property <color> offBg: dark ? #ffffff0d : #ffffffcc;
    out property <color> chipBg: dark ? #ffffff0f : #ffffffb8;
    out property <color> hairline1: dark ? #ffffff0f : #1818180d;
    out property <color> hairline2: dark ? #ffffff1a : #18181814;
    out property <color> hairline3: dark ? #ffffff29 : #1818181f;
    out property <color> rowOnEdge: dark ? #ffffff4c : #18181838;
    out property <color> switchOff: dark ? #ffffff33 : #1818182e;
    out property <color> sliderRail: dark ? #ffffff29 : #18181824;
    out property <color> shadow: dark ? #0000004c : #1818180f;
    out property <color> blobWarm: dark ? #968a764c : #706a606b;
    out property <color> blobCool: dark ? #5a5a5638 : #28282633;
    out property <color> trackShade3: dark ? #8c8c86 : #8c8c86;
    out property <color> thumb: dark ? #ededea : #ffffff;
    out property <color> ok: dark ? #3ccb7f : #0f7553;
    out property <color> focusRing: dark ? #ffffff29 : #1818181a;
}
