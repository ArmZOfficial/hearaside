# Copy to .env.local for development. Real values live in the Vercel project settings only.
# VITE_* values are built into the browser JavaScript: never put a secret in a VITE_ variable.

# --- browser (public) ---
VITE_SUPABASE_URL=https://rubprydhigfeygwlckrf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_TURNSTILE_SITE_KEY=
# "memory" = the local in-memory accounts of `npm run dev` (no Supabase needed, for testing)
VITE_AUTH_MODE=
VITE_SITE_URL=https://hearaside.netlify.app

# --- server only ---
SUPABASE_URL=https://rubprydhigfeygwlckrf.supabase.co
SUPABASE_SECRET_KEY=
DATABASE_URL=
PLUGIN_TOKEN_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
SITE_URL=https://hearaside.netlify.app
# back office (/admin): comma-separated e-mail addresses allowed in (must be confirmed accounts). Empty = nobody.
ADMIN_EMAILS=
# where "import downloads from GitHub" looks (default ArmZOfficial/hearaside)
GITHUB_REPO=
# "memory" = keep accounts in memory (dev / tests / the plug-in mock server); empty = Supabase
STORE=
